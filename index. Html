        let usdRate = parseFloat(getSecureItem('malak_usd_rate')) || 89500;
        document.getElementById('usd-rate-input').value = usdRate;
        function updateUsdRate(val) {
            usdRate = parseFloat(val) || 89500;
            setSecureItem('malak_usd_rate', usdRate);
            renderCart();
        }
